{
  "opencollection": "1.0.0",
  "info": {
    "name": "Phemex Contract Trading Account Trades API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-phemex-access-token",
      "value": "{{x-phemex-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Trades",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get trade history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/exchange/order/trade",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "tradeType",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "withCount",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query user trade execution history."
        },
        {
          "info": {
            "name": "Get futures trade history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/api-data/futures/trades",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query trade execution history."
        },
        {
          "info": {
            "name": "Get user trades",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/exchange/order/v2/tradingList",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query"
              },
              {
                "name": "execType",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "withCount",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query user trades by hedged perpetual symbol."
        },
        {
          "info": {
            "name": "Get hedged trade history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/api-data/g-futures/trades",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query trade history for hedged perpetuals."
        },
        {
          "info": {
            "name": "Query trade history (deprecated)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/exchange/spot/order/trades",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query spot trade history. This endpoint is deprecated."
        },
        {
          "info": {
            "name": "Get spot trade history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/api-data/spots/trades",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query trade history by symbol."
        },
        {
          "info": {
            "name": "Get spot trades by order ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.phemex.com/api-data/spots/trades/by-order-id",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderID",
                "value": "",
                "type": "query"
              },
              {
                "name": "clOrdID",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query trades by order IDs."
        }
      ]
    }
  ],
  "bundled": true
}